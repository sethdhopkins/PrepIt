@using Source.Models.MealPlanning
@model RecipeQueueViewModel

@{
    ViewData["Title"] = "Planner";
}

<div class="container text-center">

    <h1 class="mb-4">&lt;This Week&gt;</h1>

    @if (Model.Recipes.Any())
    {
        <div class="fixed-bottom bg-light border-top shadow recipe-planner-footer">

            <div class="container-fluid px-3 py-3">

                <div class="row row-cols-1 row-cols-sm-3 row-cols-lg-6 g-3">

                    @foreach (var recipe in Model.Recipes)
                    {
                        <div class="col">

                            <div class="card h-100">

                                <div class="card-body text-center">

                                    <h5 class="card-title">
                                        @recipe.Recipe.Name
                                    </h5>

                                    <div class="position-relative d-inline-block">

                                        <img src="@recipe.Recipe.Image"
                                             alt="@recipe.Recipe.Name"
                                             class="img-fluid rounded"
                                             style="max-width: 125px;" />

                                        <button type="button"
                                                class="btn btn-success rounded-circle position-absolute center-0 end-0 m-2"
                                                style="width: 40px; height: 40px;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#dateModal"
                                                data-recipe-id="@recipe.RecipeId"
                                                data-recipe-name="@recipe.Recipe.Name">
                                            <strong>+</strong>
                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>

                <div class="mt-3">

                    <nav aria-label="Recipe queue pagination">

                        <ul class="pagination justify-content-center mb-0">

                            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)">
                                    Previous
                                </a>

                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i">
                                        @i
                                    </a>

                                </li>
                            }

                            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)">
                                    Next
                                </a>

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>

        </div>
    }
</div>

<div class="modal fade" id="dateModal" tabindex="-1" aria-labelledby="dateModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="dateModalLabel">
                    Add Recipe
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-action="AddMeal" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="selectedRecipeId"
                           name="recipeId" />

                    <p>
                        Select a date for
                        <strong id="selectedRecipeName"></strong>
                    </p>

                    <label for="mealType" class="form-label">
                        Meal Type
                    </label>

                    <select class="form-select"
                        id="mealType"
                        name="mealType"
                        asp-items="Html.GetEnumSelectList<Meal.MealType>()"
                        required>
                        <option value="">Select meal type</option>
                    </select>

                    <label for="mealDate" class="form-label">
                        Meal date
                    </label>

                    <input type="date"
                           class="form-control"
                           id="mealDate"
                           name="mealDate"
                           required />

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Add
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<script>
// JavaScript for Index view
const dateModal = document.getElementById('dateModal');

dateModal.addEventListener('show.bs.modal', function (event) {

const button = event.relatedTarget;

const recipeId = button.getAttribute('data-recipe-id');
const recipeName = button.getAttribute('data-recipe-name');

document.getElementById('selectedRecipeId').value = recipeId;
document.getElementById('selectedRecipeName').textContent = recipeName;

// Default to today
const today = new Date().toISOString().split('T')[0];
document.getElementById('mealDate').value = today;
});
</script>