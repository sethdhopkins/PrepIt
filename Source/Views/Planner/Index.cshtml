@using Source.Models.MealPlanning
@model RecipeQueueViewModel

@{
    ViewData["Title"] = "Planner";
}

<div class="container text-center">

    <div class="calendar-header my-2">
        <button type="button" class="week-nav" onclick="previousWeek()">
            &lt;
        </button>

        <span id="weekLabel">@Model.WeekStart - @Model.WeekEnd</span>

        <button type="button" class="week-nav" onclick="nextWeek()">
            &gt;
        </button>
    </div>

    @if (Model.Plan != null)
    {
        <form asp-controller="ShoppingList" asp-action="GenerateShoppingList" method="post">

                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="mealPlanId"
                       value="@Model.Plan.Id" />
                <button type="submit"
                        class="btn btn-success"
                        style="width: 40px; height: 40px;"
                        title="Generate Shopping List">
                <i class="bi bi-cart"></i>
                </button>
        </form>
        <div class="container my-5 meal-planner-page">

            @foreach (var day in Model.WeekDays)
            {
                var dayMeals = Model.Plan.Meals
                    .Where(m => m.MealDate == day)
                    .ToList();

                <div class="row mb-4 meal-planner-day-section">

                    <div class="col-12">
                        @if (day == DateOnly.FromDateTime(DateTime.Today))
                        {
                            <h4>Today</h4>
                        }
                        else if (day == DateOnly.FromDateTime(DateTime.Today).AddDays(1))
                        {
                            <h4>Tomorrow</h4>
                        }
                        else
                        {
                            <h4>@day.ToString("dddd, MMMM d")</h4>
                        }
                    </div>

                    @if (dayMeals.Any())
                    {
                        @foreach (var meal in dayMeals)
                        {
                            <div class="col-12 col-sm-6 col-lg-4 mb-3">

                                <div class="card h-100 section-card">

                                    <div class="card-body text-center">

                                        <h5 class="card-title">
                                            @meal.Name
                                        </h5>

                                        <div class="position-relative d-inline-block">

                                            <img src="@meal.Image"
                                                 alt="@meal.Name"
                                                 class="img-fluid rounded"
                                                 style="max-width: 125px;" />

                                            <form asp-action="DeleteMeal"
                                                  method="post"
                                                  class="position-absolute top-0 end-0 m-2">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="mealId" value="@meal.Id" />

                                                <button type="submit"
                                                        class="btn btn-danger"
                                                        style="width: 40px; height: 40px;"
                                                        title="Delete meal"
                                                        onclick="return confirm('Are you sure you want to delete this meal?')">
                                                    <i class="bi bi-trash"></i>
                                                    
                                                </button>

                                            </form>

                                        </div>

                                        <div class="mt-2">
                                            <span class="badge bg-secondary">
                                                @meal.Type
                                            </span>
                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="text-muted">
                                No meals planned.
                            </div>
                        </div>
                    }

                </div>
            }

        </div>
    }
    
    @if (Model.Queue.Any())
    {
        //Queued recipes at bottom of page
        <div class="fixed-bottom bg-light border-top shadow meal-planner-footer">

            <div class="container-fluid px-3 py-3">

                <div class="recipe-queue-scroll">
                    <div class="recipe-queue-row">

                        @foreach (var recipe in Model.Queue)
                        {
                            <div class="recipe-queue-item">

                                <div class="card h-100 section-card">

                                    <div class="card-body text-center">

                                        <h5 class="card-title">
                                            @recipe.Name
                                        </h5>

                                        <div class="position-relative d-inline-block">

                                            <img src="@recipe.Image"
                                                 alt="@recipe.Name"
                                                 class="img-fluid rounded"
                                                 style="max-width: 125px;" />

                                                <form asp-action="DeleteQueuedMeal"
                                                      method="post"
                                                      class="position-absolute bottom-0 end-0 m-2">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="itemId"
                                                           value="@recipe.Id" />

                                                    <button type="submit"
                                                            class="btn btn-danger"
                                                            style="width: 40px; height: 40px;"
                                                            title="Delete meal"
                                                            onclick="return confirm('Are you sure you want to delete this meal?')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>

                                            <button type="button"
                                                    class="btn btn-success rounded-circle position-absolute top-0 end-0 m-2"
                                                    style="width: 40px; height: 40px;"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#dateModal"
                                                    data-item-id="@recipe.Id"
                                                    data-recipe-id="@recipe.RecipeId"
                                                    data-recipe-name="@recipe.Name">
                                                <strong>+</strong>
                                            </button>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                </div>

            </div>

        </div>
    }
    else
    {
        <p class="text-muted">@Model.QueueMessage</p>
    }
</div>
<div class="modal fade" id="dateModal" tabindex="-1" aria-labelledby="dateModalLabel" aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title" id="dateModalLabel">
                    Add Recipe
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close">
                </button>

            </div>

            <form asp-action="AddMeal" method="post">

                @Html.AntiForgeryToken()

                <div class="modal-body">

                    <input type="hidden"
                           id="selectedItemId"
                           name="Id" />

                    <input type="hidden"
                           id="selectedRecipeId"
                           name="recipeId" />

                    <p>
                        Select a date for
                        <strong id="selectedRecipeName"></strong>
                    </p>

                    <label for="mealType" class="form-label">
                        Meal Type
                    </label>

                    <select class="form-select"
                        id="mealType"
                        name="type"
                        asp-items="Html.GetEnumSelectList<Meal.MealType>()"
                        required>
                        <option value="">Select meal type</option>
                    </select>

                    <label for="mealDate" class="form-label">
                        Meal date
                    </label>

                    <input type="date"
                           class="form-control"
                           id="mealDate"
                           name="mealDate"
                           required />

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-success">
                        Add
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<script>
// JavaScript for Index view
const dateModal = document.getElementById('dateModal');

dateModal.addEventListener('show.bs.modal', function (event) {

const button = event.relatedTarget;

const itemId = button.getAttribute('data-item-id');
const recipeId = button.getAttribute('data-recipe-id');
const recipeName = button.getAttribute('data-recipe-name');

document.getElementById('selectedItemId').value = itemId;
document.getElementById('selectedRecipeId').value = recipeId;
document.getElementById('selectedRecipeName').textContent = recipeName;

// Default to today
const today = new Date().toISOString().split('T')[0];
document.getElementById('mealDate').value = today;
});

let weekStart = new Date(
    '@Model.WeekStart.ToString("yyyy-MM-dd")'
);

function goToWeek() {
    const date = weekStart.toISOString().split('T')[0];

    window.location.href =
        `/Planner/Index?weekStart=${date}`;
}

function previousWeek() {
    weekStart.setDate(weekStart.getDate() - 7);
    goToWeek();
}

function nextWeek() {
    weekStart.setDate(weekStart.getDate() + 7);
    goToWeek();
}
</script>