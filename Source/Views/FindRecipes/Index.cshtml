@model List<Source.Api.MealDb.MealDbRecipe>

@{
    ViewData["Title"] = "Find Recipes";
}

<div class="container text-center">

    <div>
        <form method="get" asp-controller="FindRecipes" asp-action="Index">

            <label for="searchTerm">Search:</label>

            <input class="form-control mt-4"
                   type="text"
                   id="searchTerm"
                   name="searchTerm"
                   value="@Context.Request.Query["searchTerm"]" />

            <button class="btn btn-primary mt-4" type="submit">
                Search
            </button>

        </form>
    </div>


    @if (Model.Any())
    {
        <form method="post">

            @Html.AntiForgeryToken()

            <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 g-4 mt-2">

                @foreach (var recipe in Model)
                {
                    <div class="col">

                        <div class="card h-100">

                            <div class="card-body">

                                <h3 class="card-title">
                                    @recipe.StrMeal
                                </h3>

                                <div class="position-relative d-inline-block">

                                    <img src="@recipe.StrMealThumb"
                                         alt="@recipe.StrMeal"
                                         class="img-fluid rounded"
                                         style="max-width: 200px;" />

                                    <!-- Checkbox overlay -->
                                    <div class="position-absolute top-0 end-0 p-2">
                                        <div class="form-check bg-white bg-opacity-75 rounded px-2 py-1 shadow-sm">

                                            <label class="form-check-label visually-hidden"
                                                   for="recipe-@recipe.IdMeal">
                                                Select Recipe
                                            </label>

                                            <input class="form-check-input m-0"
                                                   type="checkbox"
                                                   name="selectedRecipeIds"
                                                   value="@recipe.IdMeal"
                                                   id="recipe-@recipe.IdMeal" />

                                        </div>
                                    </div>

                                </div>

                                <p class="mt-2">
                                    <strong>Category:</strong> @recipe.StrCategory
                                </p>

                            </div>

                        </div>

                    </div>
                }

            </div>

            <div class="fixed-bottom bg-light border-top shadow p-3 text-center">
                <button class="btn btn-success px-5"
                        type="submit"
                        asp-action="AddToQueue">
                    Add Meals
                </button>

                <button class="btn btn-success px-5"
                        type="submit"
                        asp-action="AddToSaved">
                    Save
                </button>
            </div>

        </form>
    }
    else
    {
        <p>No recipes found.</p>
    }

</div>