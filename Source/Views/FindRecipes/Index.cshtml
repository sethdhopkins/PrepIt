@model List<MealDbRecipe>

@{
    ViewData["Title"] = "Search";
}

<div class="container text-center">

    <div>
        <form method="get" asp-controller="FindRecipes" asp-action="Index">

            <label for="searchTerm">Search:</label>

            <input class="form-control mt-4"
                   type="text"
                   id="searchTerm"
                   name="searchTerm"
                   value="@Context.Request.Query["searchTerm"]" />

            <button class="btn btn-primary mt-4" type="submit">
                Search
            </button>

        </form>
    </div>

    <div class="list-group mt-4">

        @if (Model.Any())
        {
            @foreach (var recipe in Model)
            {
                <div class="list-group-item mb-3">
                    <div class="form-check justify-content-end">
                        <input class="form-check-input " type="checkbox" value="" id="${@recipe.IdMeal}" />
                        <label class="form-check-label" for="${@recipe.IdMeal}">
                            Add to Queue
                        </label>
                        <h3>@recipe.StrMeal</h3>

                        <img src="@recipe.StrMealThumb"
                             alt="@recipe.StrMeal"
                             class="img-fluid"
                             style="max-width: 300px;" />

                        <p>
                            <strong>Category:</strong> @recipe.StrCategory
                        </p>
                    </div>
                    
                </div>
            }
        }
        else
        {
            <p>No recipes found.</p>
        }

    </div>
</div>